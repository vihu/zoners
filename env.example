# Copy to .env. `docker compose up` reads it.
# Real environment variables win over this file. No quotes, no inline comments.

# The port zoners-web listens on and Compose publishes on 127.0.0.1.
ZONERS_PORT=5051

# The places, separated by ";". Each entry: <IANA zone> <label>.
ZONERS_ZONES=Indian/Mauritius Mauritius; Asia/Kolkata Delhi; America/New_York New York; America/Chicago Chicago; America/Los_Angeles Los Angeles; Asia/Tokyo Tokyo; Europe/London London

# Optional.
# Source zone when the browser cannot supply one (no JavaScript). Default UTC.
#TZ=Indian/Mauritius
